{
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "outDir": "./transpiled/",
    "sourceMap": true,
    "noImplicitAny": true,
    "module": "commonjs",
    "target": "es2020",
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "allowJs": true
  },
  "include": [
    "node_modules/loopringV3.js/index.ts",
    "node_modules/loopringV3.js/src/**/*",
    "./globals.d.ts",
    "./util/**/*",
    "./test/**/*",
    "./migrations/**/*",
    "./hardhat.config.ts",
    "./typechain-types/**/*"
  ]
}
